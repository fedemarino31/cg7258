{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bezier-lab.local/schemas/catalog.schema.json",
  "type": "object",
  "required": ["format", "version", "title", "examples"],
  "properties": {
    "format": { "const": "bezier-lab-catalog" },
    "version": { "const": 1 },
    "title": { "type": "string" },
    "examples": { "type": "array", "items": { "type": "object", "required": ["id", "title", "scene"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "description": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } }, "scene": { "$ref": "scene.schema.json" }, "expected": { "type": ["object", "string"] } } } }
  }
}
